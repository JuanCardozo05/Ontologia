@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cot:  <https://w3id.org/cotel/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shp:  <https://w3id.org/cotel/shapes#> .

#  Restricciones de calidad de datos (mundo cerrado), complementarias a los axiomas OWL (mundo abierto).

shp:ObservacionAccesosShape a sh:NodeShape ;
    sh:targetClass cot:ObservacionAccesos ;
    sh:property [ sh:path cot:reportadoPor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cot:ProveedorRedesServicios ;
                  sh:message "Cada observación debe tener exactamente un proveedor."@es ] ;
    sh:property [ sh:path cot:enMunicipio ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cot:Municipio ] ;
    sh:property [ sh:path cot:enPeriodo ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cot:PeriodoReporte ] ;
    sh:property [ sh:path cot:deServicio ; sh:minCount 1 ; sh:class cot:ServicioTelecomunicaciones ] ;
    sh:property [ sh:path cot:usaTecnologia ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cot:TecnologiaAcceso ] ;
    sh:property [ sh:path cot:enSegmento ; sh:maxCount 1 ; sh:class cot:SegmentoMercado ] ;
    sh:property [ sh:path cot:numeroAccesos ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:nonNegativeInteger ] ;
    sh:property [ sh:path cot:velocidadBajadaMbps ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path cot:velocidadBajadaMbps ; sh:maxInclusive 10000 ; sh:severity sh:Warning ;
                  sh:message "Velocidad de bajada > 10 Gbps: posible error de unidades en la fuente."@es ] ;
    sh:property [ sh:path cot:velocidadSubidaMbps ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] ;
    sh:property [ sh:path cot:velocidadSubidaMbps ; sh:maxInclusive 10000 ; sh:severity sh:Warning ;
                  sh:message "Velocidad de subida > 10 Gbps: posible error de unidades en la fuente."@es ] ;
    sh:property [ sh:path cot:tieneFuente ; sh:minCount 1 ;
                  sh:message "Toda observación debe declarar su fuente (trazabilidad)."@es ] .

shp:MunicipioShape a sh:NodeShape ;
    sh:targetClass cot:Municipio ;
    sh:property [ sh:path cot:codigoDANE ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9]{5}$" ] ;
    sh:property [ sh:path cot:perteneceADepartamento ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cot:Departamento ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ] ;
    sh:sparql [
        sh:message "Los dos primeros dígitos del código DANE del municipio deben coincidir con su departamento."@es ;
        sh:select """
            SELECT $this ?codigo WHERE {
                $this <https://w3id.org/cotel/ontology#codigoDANE> ?codigo ;
                      <https://w3id.org/cotel/ontology#perteneceADepartamento>/<https://w3id.org/cotel/ontology#codigoDANE> ?dep .
                FILTER (SUBSTR(?codigo, 1, 2) != ?dep)
            }""" ] .

shp:DepartamentoShape a sh:NodeShape ;
    sh:targetClass cot:Departamento ;
    sh:property [ sh:path cot:codigoDANE ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9]{2}$" ] .

shp:ProveedorShape a sh:NodeShape ;
    sh:targetClass cot:ProveedorRedesServicios ;
    sh:property [ sh:path cot:razonSocial ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cot:nit ; sh:maxCount 1 ; sh:pattern "^[0-9]{6,10}-[0-9]$" ] .

shp:TrimestreShape a sh:NodeShape ;
    sh:targetClass cot:Trimestre ;
    sh:property [ sh:path cot:anio ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                  sh:minInclusive 2000 ; sh:maxInclusive 2100 ] ;
    sh:property [ sh:path cot:numeroTrimestre ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 1 ; sh:maxInclusive 4 ] .

shp:FuenteShape a sh:NodeShape ;
    sh:targetClass cot:FuenteDatos ;
    sh:property [ sh:path <http://purl.org/dc/terms/title> ; sh:minCount 1 ] ;
    sh:property [ sh:path <http://purl.org/dc/terms/publisher> ; sh:minCount 1 ; sh:class cot:Organizacion ] .
