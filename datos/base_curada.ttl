    rdfs:label "Colombia"@es ; cot:codigoDANE "170" ;
    owl:sameAs <http://www.wikidata.org/entity/Q739> .

## Grupo y operador
res:org-america-movil a cot:GrupoEmpresarial ;
    rdfs:label "América Móvil"@es ; cot:razonSocial "América Móvil, S.A.B. de C.V." .

res:org-comcel a cot:ProveedorRedesServicios ;
    rdfs:label "Claro Colombia (Comcel)"@es ;
    cot:razonSocial "COMUNICACION CELULAR S A COMCEL S A" ;
    cot:nit "800153993-7" ;
    rdfs:comment "VERIFICAR NIT en el RUES antes de publicar."@es ;
    cot:esSubsidiariaDe res:org-america-movil ;
    cot:operaMarca res:marca-claro ;
    cot:reguladoPor res:org-crc , res:org-mintic , res:org-sic , res:org-ane .

res:org-telmex-colombia a cot:ProveedorRedesServicios ;
    rdfs:label "Telmex Colombia"@es ;
    cot:razonSocial "TELMEX COLOMBIA S.A." ;
    cot:fusionadaEn res:org-comcel ;
    rdfs:comment "Razón social histórica de la operación fija de Claro, presente en series anteriores de MinTIC. VERIFICAR fecha y acto de fusión."@es .

res:marca-claro a cot:MarcaComercial ;
