PREFIX cot:  <https://w3id.org/cotel/ontology#>
PREFIX res:  <https://w3id.org/cotel/resource/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
# CQ2. ¿Cuál es la participación de Claro en accesos de Internet fijo en cada departamento?
SELECT ?departamento (SUM(?nClaro) AS ?accesosClaro) (SUM(?n) AS ?accesosTotales)
       (ROUND(10000 * SUM(?nClaro) / SUM(?n)) / 100 AS ?participacionClaroPct)
WHERE {
  ?obs a cot:ObservacionAccesos ; cot:reportadoPor ?p ; cot:numeroAccesos ?n ;
       cot:enMunicipio/cot:perteneceADepartamento/rdfs:label ?departamento .
  BIND (IF(?p = res:org-comcel, ?n, 0) AS ?nClaro)
}
GROUP BY ?departamento
ORDER BY DESC(?participacionClaroPct)
