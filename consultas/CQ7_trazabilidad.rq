PREFIX cot:  <https://w3id.org/cotel/ontology#>
PREFIX res:  <https://w3id.org/cotel/resource/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
# CQ7. ¿De qué fuente, publicador y URL proviene cada conjunto de observaciones?
PREFIX qb:   <http://purl.org/linked-data/cube#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?conjunto ?fuente ?publicador ?url
WHERE {
  ?ds a qb:DataSet ; rdfs:label ?conjunto ; cot:tieneFuente ?f .
  ?f dct:title ?fuente ; dct:publisher/rdfs:label ?publicador ; dcat:landingPage ?url .
}
