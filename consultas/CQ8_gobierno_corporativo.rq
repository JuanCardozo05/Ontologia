PREFIX cot:  <https://w3id.org/cotel/ontology#>
PREFIX res:  <https://w3id.org/cotel/resource/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
# CQ8. ¿Quién controla al operador de la marca Claro, qué razones sociales absorbió y qué entidades lo regulan?
SELECT ?operador ?controlante ?absorbida ?regulador
WHERE {
  ?op cot:operaMarca res:marca-claro ; rdfs:label ?operador ;
      cot:esSubsidiariaDe/rdfs:label ?controlante ;
      cot:reguladoPor/rdfs:label ?regulador .
  OPTIONAL { ?abs cot:fusionadaEn ?op ; rdfs:label ?absorbida }
}
